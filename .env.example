# --- Required ---
GATEWAY_URL=https://your-tunnel.trycloudflare.com
GATEWAY_KEY=the-same-secret-you-set-in-the-gateway
SECRET_KEY=change-me-to-a-long-random-string

# --- Optional ---
ENABLED_LANGS=en,ha,yo,ig
MAX_AUDIO_S=90
DASHBOARD_KEY=choose-a-dashboard-password
DB_PATH=data/sauti.db

# --- WhatsApp: PAUSED for now. Leave WHATSAPP_ENABLED=0 (the web app does not need any of this) ---
WHATSAPP_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
PUBLIC_BASE_URL=https://your-flask-tunnel.trycloudflare.com

# --- Optional tuning ---
RATE_LIMIT_PER_HOUR=30
WHATSAPP_VERIFY_SIGNATURE=1   # set 0 ONLY to debug a signature mismatch
WHATSAPP_ACK=1                # 1 = send a 'working on it' message (uses more Twilio messages)

# --- Hosting (Render) ---
ADMIN_KEY=long-random-string   # lets the GPU notebook register its URL and lets you download DB backups
DEMO_VIDEO_URL=              # shown to visitors when the GPU server is offline
